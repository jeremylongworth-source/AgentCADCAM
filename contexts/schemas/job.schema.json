{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jeremylongworth-source/AgentCADCAM/schemas/job.schema.json",
  "title": "CAD/CAM Job Context",
  "type": "object",
  "additionalProperties": false,
  "required": ["job_id", "revision", "process_family", "artifacts", "approval_status"],
  "properties": {
    "job_id": {"type": "string", "minLength": 1},
    "revision": {"type": "string", "minLength": 1},
    "process_family": {"enum": ["cad_handoff", "cnc_milling", "additive", "laser_cutting", "unknown"]},
    "artifacts": {"type": "array", "items": {"$ref": "handoff.schema.json#/$defs/artifact"}},
    "units": {"type": ["string", "null"]},
    "material": {"type": ["object", "null"]},
    "machine_profile": {"type": ["object", "null"]},
    "controller_profile": {"type": ["object", "null"]},
    "setup": {"type": ["object", "null"]},
    "workholding": {"type": ["object", "null"]},
    "tool_library": {"type": ["object", "null"]},
    "cam_system": {"type": ["string", "null"]},
    "postprocessor": {"type": ["object", "null"]},
    "simulation_status": {"type": ["string", "null"]},
    "verification_results": {"type": "array", "items": {"type": "object"}},
    "jurisdiction": {"type": ["string", "null"]},
    "ip_status": {"type": ["object", "null"]},
    "export_review_status": {"type": ["string", "null"]},
    "approval_status": {"enum": ["not_requested", "pending", "approved", "invalidated", "rejected"]}
  }
}

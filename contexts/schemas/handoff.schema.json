{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jeremylongworth-source/AgentCADCAM/schemas/handoff.schema.json",
  "title": "Manufacturing Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": ["handoff_id", "job_id", "revision", "status", "artifacts", "blockers", "review_required"],
  "properties": {
    "handoff_id": {"type": "string", "minLength": 1},
    "job_id": {"type": "string", "minLength": 1},
    "revision": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "review_required", "blocked", "approved", "invalidated"]},
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "review_required": {"const": true},
    "approval_id": {"type": ["string", "null"]}
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "publisher", "locator", "accessed_at"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "publisher": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1},
        "published_at": {"type": ["string", "null"]},
        "accessed_at": {"type": "string", "minLength": 1},
        "scope": {"type": ["string", "null"]}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "path", "kind", "sha256", "revision", "authority"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
        "revision": {"type": "string", "minLength": 1},
        "authority": {"enum": ["authoritative", "derived", "reference", "unknown"]},
        "units": {"type": ["string", "null"]}
      }
    }
  }
}

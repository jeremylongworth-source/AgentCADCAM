{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jeremylongworth-source/AgentCADCAM/schemas/handoff.schema.json",
  "title": "Manufacturing Handoff",
  "type": "object",
  "additionalProperties": false,
  "description": "A declared review package. Schema validity does not authenticate evidence, approval records, or physical suitability.",
  "required": ["handoff_id", "job_id", "revision", "status", "process_family", "consequence_level", "units", "artifacts", "context_fingerprint", "context_fingerprint_version", "assumptions", "verification", "simulation", "human_review", "blockers", "review_required", "execution_allowed", "approval_id"],
  "properties": {
    "handoff_id": {"$ref": "#/$defs/nonblank_text"},
    "job_id": {"$ref": "#/$defs/nonblank_text"},
    "revision": {"$ref": "#/$defs/nonblank_text"},
    "status": {"enum": ["draft", "review_required", "blocked", "approved", "invalidated"]},
    "process_family": {"enum": ["cad_handoff", "cnc_milling", "additive", "laser_cutting", "unknown"]},
    "consequence_level": {"enum": ["informational", "design_advisory", "manufacturing_planning", "execution_adjacent", "live_execution"]},
    "units": {"type": ["string", "null"], "minLength": 1, "pattern": "\\S"},
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "context_fingerprint": {"type": ["string", "null"], "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$", "description": "Fingerprint of the reviewed bounded job state, or null when unavailable. Must be compared with current state outside schema validation."},
    "context_fingerprint_version": {"const": 2},
    "assumptions": {"type": "array", "items": {"$ref": "#/$defs/assumption"}},
    "verification": {"type": "array", "items": {"$ref": "#/$defs/verification_check"}},
    "simulation": {"$ref": "#/$defs/simulation_review"},
    "human_review": {
      "type": "object", "additionalProperties": false,
      "required": ["action", "scope", "reviewer_role"],
      "properties": {
        "action": {"$ref": "#/$defs/nonblank_text"},
        "scope": {"$ref": "#/$defs/text_list", "minItems": 1},
        "reviewer_role": {"$ref": "#/$defs/nonblank_text"}
      }
    },
    "blockers": {"$ref": "#/$defs/text_list"},
    "review_required": {"const": true},
    "execution_allowed": {"const": false},
    "approval_id": {"type": ["string", "null"], "minLength": 1, "pattern": "\\S"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "approved"}}},
      "then": {
        "properties": {
          "approval_id": {"type": "string"},
          "context_fingerprint": {"type": "string"},
          "units": {"type": "string"},
          "process_family": {"not": {"const": "unknown"}},
          "blockers": {"maxItems": 0},
          "artifacts": {"minItems": 1, "contains": {"properties": {"authority": {"const": "authoritative"}}}, "items": {"properties": {"authority": {"not": {"const": "unknown"}}}}},
          "assumptions": {"items": {"properties": {"status": {"const": "resolved"}}}},
          "verification": {"minItems": 1, "items": {"properties": {"status": {"const": "passed"}}}},
          "simulation": {"properties": {"status": {"enum": ["verified", "not_required"]}}}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "approved"}, "process_family": {"const": "cnc_milling"}, "consequence_level": {"const": "execution_adjacent"}}},
      "then": {"properties": {
        "simulation": {"properties": {"status": {"const": "verified"}}},
        "verification": {
          "minItems": 2, "items": {"$ref": "#/$defs/cnc_verification_check"},
          "allOf": [
            {"contains": {"required": ["kind"], "properties": {"kind": {"const": "simulation"}}}},
            {"contains": {"required": ["kind"], "properties": {"kind": {"const": "verification"}}}}
          ]
        }
      }}
    },
    {
      "if": {"properties": {"consequence_level": {"const": "live_execution"}}},
      "then": {"properties": {"status": {"const": "blocked"}, "blockers": {"contains": {"const": "BLOCK_EXECUTION"}}}}
    },
    {
      "if": {
        "anyOf": [
          {"properties": {"status": {"enum": ["blocked", "invalidated"]}}},
          {"properties": {"context_fingerprint": {"type": "null"}}},
          {"properties": {"units": {"type": "null"}}},
          {"properties": {"process_family": {"const": "unknown"}}},
          {"properties": {"artifacts": {"maxItems": 0}}},
          {"properties": {"verification": {"maxItems": 0}}},
          {"properties": {"verification": {"contains": {"properties": {"status": {"enum": ["not_run", "failed", "inconclusive"]}}}}}},
          {"properties": {"assumptions": {"contains": {"properties": {"status": {"enum": ["unresolved", "rejected"]}}}}}},
          {"properties": {"simulation": {"properties": {"status": {"enum": ["unknown", "required", "failed"]}}}}}
        ]
      },
      "then": {"properties": {"blockers": {"minItems": 1}}}
    }
  ],
  "$defs": {
    "profile_lifecycle": {
      "type": "object", "additionalProperties": false,
      "required": ["revision", "applicability", "units", "verification"],
      "properties": {
        "revision": {"type": ["string", "null"], "minLength": 1, "pattern": "\\S"},
        "applicability": {"$ref": "#/$defs/nonblank_text"},
        "units": {"type": "object", "propertyNames": {"$ref": "#/$defs/nonblank_text"}, "additionalProperties": {"type": ["string", "null"], "minLength": 1, "pattern": "\\S"}},
        "verification": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "reviewed_revision", "reviewer", "reviewed_at", "evidence", "notes"],
          "properties": {
            "status": {"enum": ["unknown", "unverified", "verified", "conflicted", "rejected"]},
            "reviewed_revision": {"type": ["string", "null"], "minLength": 1, "pattern": "\\S"},
            "reviewer": {"type": ["string", "null"], "minLength": 1, "pattern": "\\S"},
            "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
            "evidence": {"$ref": "#/$defs/text_list"},
            "notes": {"$ref": "#/$defs/nonblank_text"}
          }
        }
      },
      "allOf": [{
        "if": {"properties": {"verification": {"properties": {"status": {"const": "verified"}}}}},
        "then": {"properties": {
          "revision": {"type": "string"},
          "verification": {"properties": {
            "reviewed_revision": {"type": "string"}, "reviewer": {"type": "string"},
            "reviewed_at": {"type": "string"}, "evidence": {"minItems": 1}
          }}
        }}
      }]
    },
    "nonblank_text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "text_list": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonblank_text"}},
    "assumption": {
      "type": "object", "additionalProperties": false,
      "required": ["statement", "status", "evidence"],
      "properties": {
        "statement": {"$ref": "#/$defs/nonblank_text"},
        "status": {"enum": ["unresolved", "resolved", "rejected"]},
        "evidence": {"$ref": "#/$defs/text_list"}
      },
      "allOf": [{"if": {"properties": {"status": {"const": "resolved"}}}, "then": {"properties": {"evidence": {"minItems": 1}}}}]
    },
    "verification_check": {
      "type": "object", "additionalProperties": false,
      "required": ["check_id", "status", "summary", "evidence"],
      "properties": {
        "check_id": {"$ref": "#/$defs/nonblank_text"},
        "kind": {"enum": ["simulation", "verification"]},
        "context_binding": {
          "type": "object", "additionalProperties": false,
          "required": ["version", "fingerprint"],
          "properties": {
            "version": {"type": "integer", "const": 1},
            "fingerprint": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$"}
          }
        },
        "status": {"enum": ["not_run", "passed", "failed", "inconclusive"]},
        "summary": {"$ref": "#/$defs/nonblank_text"},
        "evidence": {"$ref": "#/$defs/text_list"}
      },
      "allOf": [{"if": {"properties": {"status": {"const": "passed"}}}, "then": {"properties": {"evidence": {"minItems": 1}}}}]
    },
    "cnc_verification_check": {
      "allOf": [
        {"$ref": "#/$defs/verification_check"},
        {"required": ["kind", "context_binding"], "properties": {"evidence": {"minItems": 1}}}
      ]
    },
    "simulation_review": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "reason", "required_checks", "evidence"],
      "properties": {
        "status": {"enum": ["unknown", "not_required", "required", "verified", "failed"]},
        "reason": {"$ref": "#/$defs/nonblank_text"},
        "required_checks": {"$ref": "#/$defs/text_list"},
        "evidence": {"$ref": "#/$defs/text_list"}
      },
      "allOf": [
        {"if": {"properties": {"status": {"enum": ["required", "verified", "failed"]}}}, "then": {"properties": {"required_checks": {"minItems": 1}}}},
        {"if": {"properties": {"status": {"const": "verified"}}}, "then": {"properties": {"evidence": {"minItems": 1}}}},
        {"if": {"properties": {"status": {"const": "not_required"}}}, "then": {"properties": {"required_checks": {"maxItems": 0}}}}
      ]
    },
    "source_review": {
      "type": "object", "additionalProperties": false,
      "description": "A reviewer's bounded source assessment, not source authentication or legal/engineering approval.",
      "required": ["status", "authority", "reviewer", "reviewed_at", "valid_through", "applies_to", "evidence", "source_sha256"],
      "properties": {
        "status": {"enum": ["verification_required", "reviewed", "stale", "conflicted"]},
        "authority": {"enum": ["unknown", "standards_body", "government_research", "oem_documentation", "primary_tool_documentation", "primary_research", "community"]},
        "reviewer": {"type": ["string", "null"], "minLength": 1, "pattern": "\\S"},
        "reviewed_at": {"type": ["string", "null"], "format": "date"},
        "valid_through": {"type": ["string", "null"], "format": "date"},
        "applies_to": {"type": "array", "uniqueItems": true, "items": {"enum": ["machine", "controller", "material", "tool", "postprocessor", "coordinate_model", "cad_manufacturing_context", "slicer_profile", "laser_process"]}},
        "evidence": {"$ref": "#/$defs/text_list"},
        "source_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
      },
      "allOf": [{
        "if": {"properties": {"status": {"const": "reviewed"}}},
        "then": {"properties": {
          "reviewer": {"type": "string"}, "reviewed_at": {"type": "string"},
          "valid_through": {"type": "string"}, "source_sha256": {"type": "string"},
          "applies_to": {"minItems": 1}, "evidence": {"minItems": 1}
        }}
      }]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "publisher", "locator", "published_at", "accessed_at", "scope", "claims"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "publisher": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "locator": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "published_at": {"type": ["string", "null"], "minLength": 1, "pattern": "\\S", "description": "Publication date or source revision as supplied; null when unavailable, never inferred."},
        "accessed_at": {"type": "string", "format": "date"},
        "review": {"$ref": "https://github.com/jeremylongworth-source/AgentCADCAM/schemas/handoff.schema.json#/$defs/source_review"},
        "scope": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "claims": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "pattern": "\\S"}, "description": "Specific statements supported within this source's scope; metadata does not authenticate them."}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "path", "kind", "sha256", "revision", "authority"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
        "revision": {"type": "string", "minLength": 1},
        "authority": {"enum": ["authoritative", "derived", "reference", "unknown"]},
        "units": {"type": ["string", "null"]}
      }
    }
  }
}
